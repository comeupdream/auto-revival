# ---------------------------------------------------------------------------
# Revive Detail — environment variables
# Copy this file to ".env" and fill in real values. Never commit ".env".
# ---------------------------------------------------------------------------

# Postgres connection string. Use your host's URL:
#   Render   -> the database's "Internal Database URL"
#   Neon/Supabase -> the connection string they give you (add ?sslmode=require)
#   Local    -> postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Password for the /admin job book. CHANGE THIS before going live.
ADMIN_PASSWORD="changeme"

# Secret used to sign the admin session cookie. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="please-change-me-to-a-long-random-string"

# Public site URL — used for links in emails and Open Graph metadata.
NEXT_PUBLIC_SITE_URL="https://revivedetail.autos"

# Site freeze. When on, EVERY request (pages, admin, API) is answered with a
# bare "SITE DOWN UNTIL PAYMENT RENDERED" 503 and nothing else runs.
# The freeze is ON unless this is explicitly "false", "0", or "off".
SITE_FROZEN="true"

# ---------------------------------------------------------------------------
# Email notifications (optional).
# Leave RESEND_API_KEY blank and the app simply skips sending (logs instead).
# ---------------------------------------------------------------------------

# API key from https://resend.com → API Keys.
RESEND_API_KEY=""

# Verified sender. Must be on a domain you've verified in Resend, e.g.
#   "Revive Detail <hello@revivedetail.autos>"
# Until you verify a domain you can use Resend's test sender, which only
# delivers to your own Resend account email:
#   "Revive Detail <onboarding@resend.dev>"
EMAIL_FROM="Revive Detail <onboarding@resend.dev>"

# Where new-booking alerts are sent (the shop owner's inbox).
OWNER_EMAIL="owner@example.com"

# Shared secret protecting POST/GET /api/cron/reminders. Generate like
# SESSION_SECRET above. Your external scheduler passes it as
#   Authorization: Bearer <secret>   or   ?secret=<secret>
CRON_SECRET="please-change-me-to-a-long-random-string"
